{
  "name": "conversor-haberes",
  "version": "0.0.0",
  "private": true,
  "description": "Conversor local y offline de liquidaciones Finnegans a TXT bancarios (BNA GT Haberes, Patagonia B.2). No apto para pagos reales hasta homologación.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fixtures:synthetic": "node scripts/make-synthetic-fixtures.ts",
    "spike:t10": "vitest run --config vitest.local.config.ts",
    "local:f2": "vitest run --config vitest.local.config.ts f2-",
    "check:sensitive": "node scripts/check-sensitive.ts --all",
    "check:dist": "node scripts/check-dist.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:sensitive && npm run test:coverage && npm run build && npm run check:dist && npm run test:e2e"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
